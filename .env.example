# ── Checkout mode ────────────────────────────────────────────────────────────
# TEMPORARY: "mock" issues tickets instantly with no payment (Wayl routes are
# disabled). Set PAYMENTS_MODE=wayl to restore the real payment flow.
PAYMENTS_MODE=mock

# ── App ──────────────────────────────────────────────────────────────────────
